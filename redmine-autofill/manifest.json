{
  "manifest_version": 3,
  "name": "Redmine チケット自動入力",
  "version": "1.2",
  "description": "弁護士JP Redmineの新規チケット作成画面で、担当者・期日・所属を一発入力するボタンを追加します。",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "一発入力の設定",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://redmine.vbest.co.jp/projects/*/issues/new*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
